VITE_LIVE_FEED_URL=http://localhost:8090
# Same Envoy listener as VITE_LIVE_FEED_URL — one grpc-web listener
# routes both services by gRPC path (see envoy/envoy.yaml), so this is
# the same host:port today, kept as its own var so QueryService could
# move behind a different listener later without a LiveFeedService change.
VITE_QUERY_URL=http://localhost:8090
